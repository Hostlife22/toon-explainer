{
  "_about": "map-views.js: map views ( living-region hooks, overlays, icons). New map fields are not validated by spec.py; they are listed in _fields for documentation and checked in JS.",
  "kinds": {
    "map_icon": ["fort", "camp", "formation", "factory", "derrick", "plane", "church-hut", "rubble"],
    "map_view": ["tilt", "globe", "tabletop"]
  },
  "registry": { "map_icon": "TOON.MAP_ICONS", "map_view": "TOON.MAP_VIEWS" },
  "_fields": {
    "map": ["view", "tilt", "globe", "table", "figures", "arrows", "brawls", "fires", "trails", "tracks", "forts", "camps", "squads", "flags", "coins", "xmarks", "barriers", "words", "drops", "tacks", "hand"],
    "region": ["split", "shatter", "slash", "engulf", "peel", "drift", "wipe", "annex", "damage", "surrender", "fire", "conquer.pattern", "conquer.blobs", "conquer.chunk", "conquer.rays"],
    "region_moods": ["plead", "hearts", "pipe", "dollar"],
    "damage_kinds": ["black-eye", "x-eye", "bandage", "crack"],
    "arrow_styles": ["flat", "block", "hook"],
    "camp_styles": ["palisade", "camp", "formation", "blob"],
    "squad_formations": ["diamond", "line", "blob"],
    "word_styles": ["shade", "toon", "extrude"],
    "drop_props": ["bandage", "stamp", "foot", "any T.PROPS kind"],
    "figure_enter": ["pop", "stretch", "drop", "none"],
    "figure_sit": ["throne", "deckchair", "bed"]
  }
}
